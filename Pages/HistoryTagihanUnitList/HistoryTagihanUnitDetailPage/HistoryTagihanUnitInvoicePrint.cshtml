@page
@model TestLandingPageNet8.Pages.HistoryTagihanUnitList.HistoryTagihanUnitDetailPage.HistoryTagihanUnitInvoicePrintModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>@Model.DocumentTitle - @Model.InvoiceHeader.TransNmbr</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <style>
        @@media print {
            body { margin: 0; padding: 0; }
        }
        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #222;
            line-height: 1.3;
            font-size: 11pt;
            margin: 0;
            padding: 0;
            background-color: #fff;
        }
        .invoice-container {
            width: 180mm;
            margin: 0 auto;
            padding: 10mm 5mm;
        }
        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 5px;
        }
        .logo-area {
            text-align: left;
            font-size: 14pt;
            font-weight: bold;
            color: #000;
            vertical-align: middle;
            line-height: 1.2;
            padding-left: 10px;
        }
        .address-company {
            font-size: 9pt;
            font-weight: normal;
            color: #333;
            margin-top: 2px;
        }
        .divider-line {
            border-top: 2px solid #000;
            border-bottom: 1px solid #000;
            height: 2px;
            margin-bottom: 20px;
            margin-top: 5px;
        }
        .title-section {
            text-align: center;
            margin-bottom: 20px;
        }
        .invoice-title {
            font-size: 14pt;
            font-weight: bold;
            margin: 0;
            letter-spacing: 0.5px;
        }
        .invoice-number {
            font-size: 11pt;
            margin-top: 3px;
        }
        .meta-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
        }
        .meta-table td {
            padding: 3px 0;
            vertical-align: top;
            font-size: 11pt;
        }
        .item-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
            border: 1px solid #000;
        }
        .item-table th {
            border: 1px solid #000;
            padding: 8px;
            font-size: 11pt;
            font-weight: bold;
            text-align: center;
            background-color: #fff;
        }
        .item-table td {
            border: none; /* Menghilangkan garis horizontal/vertikal di dalam tabel item */
            padding: 8px;
            font-size: 11pt;
            vertical-align: top;
        }
        .text-right {
            text-align: right;
        }
        .terbilang-box {
            border: 1px solid #000;
            border-top: none;
            padding: 10px 8px;
            font-size: 10.5pt;
            margin-bottom: 30px;
            background-color: #fff;
        }
        .signature-section {
            width: 100%;
            margin-top: 10px;
            page-break-inside: avoid;
        }
        .signature-table {
            width: 100%;
            border-collapse: collapse;
        }
        .signature-space {
            height: 65px;
        }
        #loading-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(255,255,255,0.95); z-index: 9999;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            font-family: sans-serif; font-size: 14px; color: #333;
        }
        .spinner {
            border: 4px solid #f3f3f3; border-top: 4px solid #000;
            border-radius: 50%; width: 35px; height: 35px; animation: spin 1s linear infinite;
            margin-bottom: 10px;
        }
        @@keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <div id="loading-overlay">
        <div class="spinner"></div>
        <div>Mengekspor @Model.DocumentTitle ke PDF...</div>
    </div>

    <div id="invoice-pdf-content" class="invoice-container">

        <!-- Kop Surat Perusahaan -->
        <table class="header-table">
            <tr>
                <td style="width: 12%; text-align: left; vertical-align: middle;">
                    <div style="width: 75px; height: 75px;">
                        <img src="~/image/Logo_CV_AMT.png" alt="Logo" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                </td>
                <td class="logo-area">
                    <div style="font-size: 13pt; font-weight: bold;">@Model.InvoiceHeader.CompanyName</div>
                    <div class="address-company">@Model.InvoiceHeader.Address</div>
                </td>
            </tr>
        </table>
        
        <div class="divider-line"></div>

        <div class="title-section">
            <h1 class="invoice-title">@Model.DocumentTitle</h1>
            <div class="invoice-number">No. @Model.InvoiceHeader.TransNmbr</div>
        </div>

        <table class="meta-table">
            <tr>
                <td style="width: 140px;">Telah terima dari</td>
                <td style="width: 15px;">:</td>
                <td><strong>@Model.InvoiceHeader.CustomerName</strong></td>
            </tr>
            <tr>
                <td>Tanggal</td>
                <td>:</td>
                <td>@(Model.InvoiceHeader.DueDate.HasValue ? Model.InvoiceHeader.DueDate.Value.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("id-ID")) : "-")</td>
            </tr>
        </table>

        <!-- Tabel Item Kwitansi (Tanpa garis dalam, kolom jumlah & keterangan digabung menggunakan rowspan) -->
        <table class="item-table">
            <thead>
                <tr>
                    <th style="width: 48%; border-right: 1px solid #000;">Perihal</th>
                    <th style="width: 24%; border-right: 1px solid #000;">Jumlah</th>
                    <th style="width: 28%;">Keterangan</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int totalRows = Model.InvoiceItems.Count;
                    bool isFirstRow = true;
                }
                @for (int i = 0; i < totalRows; i++)
                {
                    var item = Model.InvoiceItems[i];
                    <tr>
                        <td style="border-right: 1px solid #000;">                            
                            @item.CommercialItem<br />
                            <span style="font-size: 10pt; color: #444;">@item.CommercialDesc</span><br />
                            <span style="font-size: 9.5pt; color: #555; font-weight: bold;">No. Inv: @item.TransNmbr</span>
                        </td>

                        @if (isFirstRow)
                        {
                            <td class="text-right" rowspan="@totalRows" style="border-right: 1px solid #000; vertical-align: middle;">
                                @Model.InvoiceHeader.TotalBayar.ToString("N0", new System.Globalization.CultureInfo("id-ID"))
                            </td>
                            <td rowspan="@totalRows" style="vertical-align: middle;">
                                Kavling @Model.InvoiceHeader.KavlingCode<br />
                                Luas: @Model.InvoiceHeader.Luas.ToString("N2", new System.Globalization.CultureInfo("id-ID")) m²
                            </td>
                            isFirstRow = false;
                        }
                    </tr>
                }
            </tbody>
        </table>

        <!-- Kotak Terbilang -->
        <div class="terbilang-box">
            <table style="width: 100%; border-collapse: collapse;">
                <tr>
                    <td style="width: 75px; vertical-align: top;"><strong>Terbilang</strong></td>
                    <td style="width: 15px; vertical-align: top;">:</td>
                    <td style="vertical-align: top; font-style: italic;">
                        "@Model.InvoiceHeader.TerbilangText"
                    </td>
                </tr>
            </table>
        </div>

        <!-- Tanda Tangan -->
        <div class="signature-section">
            <table class="signature-table">
                <tr>
                    <td style="width: 60%;"></td>
                    <td style="width: 40%; text-align: center;">
                        Yang Menerima,
                        <div class="signature-space"></div>
                        <div style="border-bottom: 1px solid #000; width: 85%; margin: 0 auto;"></div>
                    </td>
                </tr>
            </table>
        </div>

        <div style="text-align: right; font-size: 8pt; color: #888888; margin-top: 15px; font-style: italic;">
            Diunduh pada: @DateTime.Now.ToString("dd MMMM yyyy HH:mm", new System.Globalization.CultureInfo("id-ID")) WIB
        </div>

    </div>

    <script>
        window.onload = function () {
            const rawInvNo = "@Model.InvoiceHeader.TransNmbr";
            const cleanInvNo = rawInvNo.replace(/[\/\\*?:"<>|]/g, "-");
            
            const element = document.getElementById('invoice-pdf-content');
            
            const opt = {
                margin:       [0, 0, 0, 0], 
                filename:     `@Model.FilePrefix-${cleanInvNo}.pdf`,
                image:        { type: 'jpeg', quality: 1.0 },
                html2canvas:  { scale: 2, useCORS: true, logging: false, letterRendering: true },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                document.getElementById('loading-overlay').innerText = "Unduhan berhasil!";
                setTimeout(() => {
                    window.close();
                }, 600);
            }).catch(err => {
                console.error("Gagal cetak berkas:", err);
                document.getElementById('loading-overlay').innerHTML = "<span style='color:red;'>Gagal mengunduh otomatis. Silakan gunakan kombinasi pintasan Ctrl+P.</span>";
            });
        }
    </script>
</body>
</html>