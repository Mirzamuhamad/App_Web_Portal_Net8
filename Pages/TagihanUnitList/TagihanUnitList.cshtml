@page
@model Pages.TagihanUnitList.TagihanUnitListModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Daftar Tagihan";
    var culture = new System.Globalization.CultureInfo("id-ID");
}

<div class="min-h-screen bg-slate-50 pb-20">
    <div class="bg-white border-b sticky top-0 z-30 px-2 sm:px-6 py-3 shadow-sm">
        <div class="mx-auto flex items-center justify-between gap-4">
            <div class="flex items-center gap-4 min-w-0">
                <a href="/index"
                   class="w-10 h-10 flex items-center justify-center bg-slate-100 rounded-2xl text-slate-500 hover:bg-red-50 hover:text-red-600 transition">
                    <i class="ri-arrow-left-line text-xl"></i>
                </a>
                <div class="min-w-0">
                    <h1 class="text-base sm:text-lg font-bold text-slate-700 truncate">Daftar Tagihan</h1>
                    <p class="text-[10px] sm:text-xs text-slate-400 uppercase tracking-widest font-semibold">
                        Invoice belum dibayar
                    </p>
                </div>
            </div>

            <a href="/HistoryTagihanUnitList/HistoryTagihanUnitList"
               class="flex items-center gap-2 px-4 py-2 bg-slate-100 rounded-xl text-slate-600 hover:bg-teal-50 hover:text-teal-600 transition text-sm font-medium">
                <i class="ri-history-line text-lg"></i>
                <span>History</span>
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 pt-5 mx-auto px-2 sm:px-6">
        @if (Model.Invoices.Any())
        {
            @foreach (var invoice in Model.Invoices)
            {
                <a asp-page="/TagihanUnitList/TagihanUnitDetailPage/TagihanUnitDetailPage"
                   asp-route-invoiceNo="@invoice.TransNmbr"
                   class="block transform hover:scale-[1.002] transition duration-200">
                    <div class="bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-gray-100 p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 relative overflow-hidden">
                        <div class="flex items-start gap-3 flex-1 min-w-0">
                            <div class="w-1.5 h-12 rounded-full flex-shrink-0 mt-0.5 bg-red-500"></div>

                            <div class="flex-1 min-w-0">
                                <span class="text-[10px] sm:text-xs font-bold text-gray-400 uppercase tracking-wider block mb-0.5">
                                    Nomor Invoice
                                </span>
                                <h2 class="text-base sm:text-lg font-bold text-red-600 break-all">
                                    @invoice.TransNmbr
                                </h2>

                                <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400">
                                    <span class="flex items-center gap-1">
                                        <i class="ri-calendar-event-line text-red-400"></i>
                                        Jatuh tempo:
                                        @(invoice.DueDate.HasValue ? invoice.DueDate.Value.ToString("dd MMMM yyyy", culture) : "-")
                                    </span>
                                    <span class="text-amber-600 font-medium flex items-center gap-1">
                                        <i class="fa-solid fa-circle-info text-[10px]"></i>
                                        Klik untuk detail tagihan
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="border border-red-500/30 bg-red-50/10 rounded-xl p-3 flex items-center justify-between gap-4 w-full sm:w-[280px] flex-shrink-0 text-gray-700">
                            <div class="flex items-center justify-center w-8 h-8 rounded-lg flex-shrink-0 bg-red-50 text-red-500">
                                <i class="fa-solid fa-file-invoice-dollar text-sm"></i>
                            </div>

                            <div class="text-right flex-1 min-w-0">
                                <p class="text-[9px] uppercase tracking-wider text-gray-400 font-semibold leading-none mb-1.5">
                                    Total Invoice Belum Dibayar
                                </p>
                                <div class="text-base sm:text-lg font-bold tracking-tight text-gray-600 whitespace-nowrap">
                                    <span class="text-xs font-semibold text-red-500 mr-0.5">Rp</span>@invoice.TotalAmount.ToString("N0", culture)
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            }
        }
        else
        {
            <div class="bg-white rounded-2xl border border-dashed border-slate-200 p-10 text-center shadow-sm">
                <i class="ri-checkbox-circle-line text-5xl text-emerald-300"></i>
                <h2 class="mt-3 text-base font-bold text-slate-600">Tidak ada tagihan aktif</h2>
                <p class="mt-1 text-xs text-slate-400">Invoice belum dibayar untuk akun ini akan tampil di halaman ini.</p>
            </div>
        }
    </div>
</div>
