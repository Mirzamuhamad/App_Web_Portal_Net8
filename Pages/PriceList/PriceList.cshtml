@page
@model TestLandingPageNet8.Pages.PriceList.PriceListModel
@{
    if (Request.Headers.ContainsKey("HX-Request"))
    {
        Layout = null;
    }
    else
    {
        Layout = "_Layout";
    }

    ViewData["Title"] = "Pricelist Perizinan";
}

<main class=" min-h-screen px-3 pb-20 pt-5 sm:px-6 sm:pt-8">
    <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <h1 class="text-xl font-bold text-slate-700 sm:text-2xl">Pricelist Perizinan</h1>
            <p class="mt-1 text-sm text-slate-500">Daftar biaya dan formulir layanan perizinan.</p>
        </div>

        <form method="get" class="flex w-full max-w-md items-center overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
            <i class="ri-search-line ml-3 text-slate-400"></i>
            <input type="search"
                   name="search"
                   value="@Model.Search"
                   placeholder="Cari layanan..."
                   aria-label="Cari layanan perizinan"
                   class="min-w-0 flex-1 border-0 px-3 py-2.5 text-sm text-slate-600 outline-none" />
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="/PriceList/PriceList"
                   aria-label="Hapus pencarian"
                   class="px-2 text-slate-400 transition hover:text-slate-600">
                    <i class="ri-close-line text-lg"></i>
                </a>
            }
            <button type="submit" class="self-stretch bg-sky-600 px-4 text-sm font-semibold text-white transition hover:bg-sky-700">
                Cari
            </button>
        </form>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.LoadError))
    {
        <div role="alert" class="rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">
            <i class="ri-error-warning-line mr-1"></i>
            @Model.LoadError
        </div>
    }
    else if (Model.PermitPrices.Count == 0)
    {
        <div class="rounded-xl border border-dashed border-slate-300 bg-slate-50 px-5 py-12 text-center text-sm text-slate-500">
            <i class="ri-file-search-line mb-2 block text-3xl text-slate-300"></i>
            @(string.IsNullOrWhiteSpace(Model.Search)
                ? "Pricelist perizinan belum tersedia."
                : $"Layanan dengan kata kunci “{Model.Search}” tidak ditemukan.")
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var item in Model.PermitPrices)
            {
                <article x-data="permitDownload()"
                         class="relative overflow-hidden rounded-xl border border-teal-100 bg-[#F8FFFD] shadow-sm transition hover:border-teal-200 hover:shadow-md">
                    <div class="absolute inset-y-0 left-0 w-1 bg-teal-500"></div>

                    <div class="flex flex-col gap-4 py-4 pl-5 pr-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6 sm:py-5 sm:pl-6">
                        <div class="flex min-w-0 items-start gap-3">
                            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
                                <i class="ri-price-tag-3-line text-lg"></i>
                            </div>

                            <div class="min-w-0">
                                <h2 class="text-sm font-bold uppercase text-slate-800 sm:text-base">@item.Title</h2>
                                <p class="mt-1 text-xs text-slate-500">
                                    Kategori: <span class="font-semibold">@item.ServiceText</span>
                                </p>
                                <div class="mt-3">
                                    <span class="block text-xs font-medium text-slate-500">Biaya</span>
                                    <span class="mt-0.5 block text-lg font-bold text-teal-700">@item.PriceText</span>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.DocumentUrl))
                        {
                            <a href="@Url.Page("/PriceList/PriceList", "Download", new { contentId = item.ContentID })"
                               aria-label="Download formulir @item.Title"
                               :aria-busy="downloading"
                               :class="{ 'pointer-events-none opacity-70': downloading }"
                               @@click.prevent="download($event.currentTarget.href)"
                               class="inline-flex shrink-0 items-center justify-center gap-1.5 self-stretch rounded-lg bg-teal-600 px-3 py-2 text-[11px] font-semibold text-white shadow-sm transition hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-300 sm:self-center">
                                <i x-show="!downloading" class="ri-download-2-line"></i>
                                <i x-show="downloading" x-cloak class="ri-loader-4-line animate-spin"></i>
                                <span x-text="downloading ? 'Mengunduh...' : 'Download Form (PDF)'">Download Form (PDF)</span>
                            </a>
                        }
                        else
                        {
                            <span class="inline-flex shrink-0 items-center justify-center gap-1.5 self-stretch rounded-lg bg-slate-100 px-3 py-2 text-[11px] font-semibold text-slate-400 sm:self-center">
                                <i class="ri-file-warning-line"></i>
                                Form belum tersedia
                            </span>
                        }
                    </div>
                </article>
            }
        </div>
    }
</main>

<script>
    function permitDownload() {
        return {
            downloading: false,

            async download(url) {
                if (this.downloading) return;

                this.downloading = true;

                try {
                    const response = await fetch(url, {
                        method: 'GET',
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        const message = await response.text();
                        throw new Error(message || 'Dokumen tidak dapat diunduh.');
                    }

                    const blob = await response.blob();
                    const fileName = this.getFileName(response.headers.get('content-disposition'));
                    const objectUrl = URL.createObjectURL(blob);
                    const link = document.createElement('a');

                    link.href = objectUrl;
                    link.download = fileName;
                    document.body.appendChild(link);
                    link.click();
                    link.remove();

                    setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
                } catch (error) {
                    const message = error?.message || 'Dokumen tidak dapat diunduh.';

                    if (typeof showError === 'function') {
                        showError('Download Gagal', message);
                    } else {
                        alert(message);
                    }
                } finally {
                    this.downloading = false;
                }
            },

            getFileName(contentDisposition) {
                if (!contentDisposition) return 'Dokumen-Persyaratan.pdf';

                const encodedName = contentDisposition.match(/filename\*=UTF-8''([^;]+)/i);
                if (encodedName?.[1]) {
                    try {
                        return decodeURIComponent(encodedName[1]);
                    } catch (_) {
                        return encodedName[1];
                    }
                }

                const plainName = contentDisposition.match(/filename="?([^";]+)"?/i);
                return plainName?.[1] || 'Dokumen-Persyaratan.pdf';
            }
        };
    }
</script>
