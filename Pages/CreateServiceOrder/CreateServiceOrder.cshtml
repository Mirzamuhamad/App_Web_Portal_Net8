@page
@model Pages.CreateServiceOrder.CreateServiceOrderModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Service Order";
    var sourceMenu = ViewContext.HttpContext.Request.Query["from"].ToString();
    var isKeluhan = sourceMenu == "Pengaduan/Keluhan";
}

@* <link href="https://cdn.jsdelivr.net/npm/remixicon@3.5.0/fonts/remixicon.css" rel="stylesheet"> *@

<style>
    .service-order-price-panel {
        display: none;
    }

    .service-order-price-card-soft {
        background-color: #f8fffd;
    }

    .service-order-mobile-sheet {
        display: flex;
        max-height: 85vh;
        max-height: 85dvh;
        flex-direction: column;
    }

    .service-order-mobile-sheet-list {
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    @@media (min-width: 1024px) {
        .service-order-form-layout.has-price-panel {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(320px, 380px);
            align-items: start;
            gap: 1.25rem;
        }

        .service-order-price-panel {
            position: sticky;
            top: 1rem;
            display: block;
        }

        .service-order-price-list {
            max-height: calc(100vh - 12rem);
            overflow-y: auto;
        }

        .service-order-mobile-price {
            display: none !important;
        }
    }
</style>

<div class="min-h-screen bg-slate-50/50 py-2 px-0 sm:py-4 sm:px-4" x-data="complaintForm()">
    <div class="mx-auto max-w-7xl">

        <div class="mb-2 sm:mb-4 flex px-2 sm:px-0 items-center justify-between">
            <a href="/Index"
                class="w-10 h-10 flex items-center justify-center bg-white rounded-2xl shadow-sm border border-slate-200 text-slate-400 hover:text-teal-600 transition">
                <i class="ri-arrow-left-line"></i> 
            </a>
            <div>
                <h2 class="text-lg sm:text-2xl font-extrabold text-slate-800 tracking-tight">Buat Service Order</h2>
                @* <p class="text-sm text-slate-500">Laporkan kendala Anda secara cepat.</p> *@
            </div>

        </div>

        <div class="service-order-form-layout @(Model.PermitPriceList.Any() && !isKeluhan ? "has-price-panel" : null)">
        <form x-ref="form" enctype="multipart/form-data"
            class="bg-white p-2 md:p-6 rounded-2xl sm:rounded-[2.5rem] shadow-xl shadow-slate-200/40 border border-slate-100 space-y-3 sm:space-y-4">
            @Html.AntiForgeryToken()

            <div class="space-y-1">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Pilih Unit /
                    Kavling</label>
                <div class="relative">
                    <select name="Input.KavlingId" required
                        class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition appearance-none cursor-pointer">
                        
                        @foreach (var kavling in Model.KavlingList)
                        {
                            <option value="@kavling.Id">@kavling.KavlingCode</option>
                        }

                    </select>       
                    <i
                        class="ri-arrow-down-s-line absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
                </div>
            </div>

            @* <div class="space-y-1">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Judul Laporan</label>
                <input type="text" name="Input.Title" required placeholder="Masukan judul singkat..."
                    class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition">
            </div> *@

            <div class="space-y-1">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Pilih Type Service/Order</label>
                <div class="relative">
                    @if (isKeluhan)
                    {
                        <!-- Jika dari menu Keluhan, langsung kunci nilainya ke "Keluhan" -->
                        <select name="Input.Title" required id="serviceTypeSelect"
                                @@change="syncSelectedPermit()"
                                class="w-full bg-slate-100 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition appearance-none cursor-not-allowed" readonly>
                            <option value="Pengaduan/Keluhan" selected>Pengaduan/Keluhan</option>
                        </select>
                    }
                    else
                    {
                        <!-- Jika diakses normal, tampilkan semua list seperti biasa -->
                        <select name="Input.Title" required id="serviceTypeSelect"
                                @@change="syncSelectedPermit()"
                                class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition appearance-none cursor-pointer">
                            
                            @foreach (var TypeService in Model.TypeServiceList)
                            {
                                var permit = Model.PermitPriceList.FirstOrDefault(item =>
                                    string.Equals(item.TypeService?.Trim(), TypeService.TypeService?.Trim(), StringComparison.OrdinalIgnoreCase)
                                    || string.Equals(item.Title?.Trim(), TypeService.TypeService?.Trim(), StringComparison.OrdinalIgnoreCase));
                                var permitDownloadUrl = permit == null || string.IsNullOrWhiteSpace(permit.DocumentUrl)
                                    ? null
                                    : Url.Page("/CreateServiceOrder/CreateServiceOrder", "Download", new { permitId = permit.PermitID });

                                <option value="@TypeService.TypeService"
                                        data-permit-title="@permit?.Title"
                                        data-permit-subtitle="@(permit?.SubTitle ?? permit?.Description)"
                                        data-permit-price="@permit?.PriceText"
                                        data-permit-url="@permitDownloadUrl"
                                        data-permit-id="@permit?.PermitID"
                                        data-permit-filename="@permit?.DownloadFileName">@TypeService.TypeService</option>
                            }
                        </select>
                    }
                    
                    <i class="ri-arrow-down-s-line absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"></i>
                </div>
            </div>

            @if (Model.PermitPriceList.Any() && !isKeluhan)
            {
                <div class="service-order-mobile-price space-y-2">
                    <div x-show="selectedPermit" x-cloak
                         class="service-order-price-card-soft relative overflow-hidden rounded-2xl border border-teal-100 p-4 shadow-sm">
                        <div class="absolute inset-y-0 left-0 w-1 bg-teal-500"></div>
                        <div class="flex flex-col gap-4 pl-1 sm:flex-row sm:items-center sm:justify-between">
                            <div class="min-w-0">
                                <p class="text-sm font-extrabold uppercase text-slate-800" x-text="selectedPermit?.title"></p>
                                <p x-show="selectedPermit?.subtitle" class="mt-1 text-xs text-slate-500" x-text="selectedPermit?.subtitle"></p>
                                <p class="mt-2 text-sm text-slate-600">
                                    Biaya: <span class="text-base font-extrabold text-teal-700" x-text="selectedPermit?.price"></span>
                                </p>
                            </div>

                            <template x-if="selectedPermit?.documentUrl">
                                <a :href="selectedPermit.documentUrl"
                                   :download="selectedPermit.fileName"
                                   @@click.prevent="downloadDocument($event, selectedPermit.permitId, selectedPermit.fileName)"
                                   :class="{ 'pointer-events-none opacity-70': isDownloading(selectedPermit?.permitId) }"
                                   :aria-busy="isDownloading(selectedPermit?.permitId)"
                                   rel="noopener noreferrer"
                                   class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                                    <i x-show="!isDownloading(selectedPermit?.permitId)" class="ri-download-2-line"></i>
                                    <i x-show="isDownloading(selectedPermit?.permitId)" x-cloak class="ri-loader-4-line animate-spin"></i>
                                    <span x-text="isDownloading(selectedPermit?.permitId) ? 'Mengunduh...' : 'Unduh persyaratan'"></span>
                                </a>
                            </template>

                            <template x-if="selectedPermit && !selectedPermit.documentUrl">
                                <span class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-400">
                                    <i class="ri-file-warning-line"></i>
                                    Dokumen belum tersedia
                                </span>
                            </template>
                        </div>
                    </div>

                    <button type="button" x-show="selectedPermit" x-cloak @@click="showPriceList = true"
                            class="inline-flex items-center gap-2 px-1 text-xs font-bold text-teal-600 transition">
                        <i class="ri-list-check-2"></i>
                        Lihat pricelist &amp; persyaratan
                    </button>
                </div>
            }

            <div class="space-y-1">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Deskripsi (Mohon cantumkan 1 permintaan dalam 1 request) </label>
                <textarea name="Input.Description" required rows="4"
                    placeholder="Jelaskan service apa yang anda butuhkan"
                    class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3.5 text-sm focus:ring-2 focus:ring-teal-500/20 focus:border-teal-500 outline-none transition resize-none"></textarea>
            </div>

            <div class="space-y-3">
                <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Foto bagian yang butuh di service (Maks.
                    5)</label>

                <div class="grid grid-cols-3 sm:grid-cols-4 gap-3">
                    <template x-for="(img, index) in previews" :key="index">
                        <div
                            class="relative aspect-square rounded-2xl overflow-hidden border border-slate-100 group shadow-sm">
                            <img :src="img" class="w-full h-full object-cover">
                             
                            <button type="button" @@click="removeImage(index)"
                                class="absolute top-1 right-1 bg-rose-500/90 text-white w-6 h-6 rounded-lg backdrop-blur-sm flex items-center justify-center hover:bg-rose-600 transition">
                                <i class="ri-close-line"></i>
                            </button>
                        </div>
                    </template>

                    <label x-show="previews.length < 5"
                        class="aspect-square rounded-2xl border-2 border-dashed border-slate-200 flex flex-col items-center justify-center cursor-pointer hover:border-teal-500 hover:bg-teal-50/50 transition group">
                        <i class="ri-image-add-line text-2xl text-slate-300 group-hover:text-teal-500"></i>
                        <span
                            class="text-[9px] font-bold text-slate-400 group-hover:text-teal-600 mt-1 uppercase">Upload</span>
                        <input type="file" name="Input.Photos" multiple accept="image/*" class="hidden"
                            @@change="previewImages($event)">
                    </label>
                </div>
            </div>
            @* loading compress image *@
            <div x-show="compressing" class="mb-4 p-4 bg-teal-50 rounded-2xl border border-teal-100">
                <div class="flex justify-between items-center mb-2">
                    <span class="text-[10px] font-bold text-teal-600 uppercase tracking-widest">Memproses
                        Gambar...</span>
                    <span class="text-xs font-bold text-teal-600" x-text="compressProgress + '%'"></span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-1.5 overflow-hidden">
                    <div class="bg-teal-500 h-full transition-all duration-300"
                        :style="'width: ' + compressProgress + '%'"></div>
                </div>
            </div>
            @* end loading compress image  *@

            <div class="pt-4">
                <button type="button" :disabled="loading" @@click="submitForm()"
                    class="w-full bg-teal-600 hover:bg-teal-700 disabled:bg-slate-300 text-white font-bold py-4 rounded-2xl shadow-lg shadow-teal-200 transition-all flex items-center justify-center gap-3 active:scale-[0.98]">
                    <template x-if="loading">
                        <i class="ri-loader-4-line animate-spin text-xl"></i>
                    </template>
                    <span x-text="loading ? 'Sedang Mengirim...' : 'Kirim Service Order '"></span>
                </button>
            </div>

           
        </form>

        @if (Model.PermitPriceList.Any() && !isKeluhan)
        {
            <aside class="service-order-price-panel overflow-hidden rounded-[2rem] border border-slate-100 bg-white shadow-xl shadow-slate-200/40"
                   aria-labelledby="desktopPriceListTitle">
                <div class="border-b border-slate-100 px-5 py-4">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-50 text-amber-500">
                            <i class="ri-price-tag-3-line text-xl"></i>
                        </div>
                        <div>
                            <h3 id="desktopPriceListTitle" class="text-base font-extrabold text-slate-800">Pricelist layanan terpilih</h3>
                            <p class="mt-0.5 text-xs text-slate-500" x-text="selectedService || 'Pilih jenis layanan pada form'"></p>
                        </div>
                    </div>
                </div>

                <div class="service-order-price-list space-y-3 p-4">
                    <div x-show="!selectedPermit" x-cloak
                         class="rounded-2xl border border-dashed border-slate-200 bg-slate-50 px-4 py-8 text-center">
                        <i class="ri-file-search-line mb-2 block text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold text-slate-500">Pricelist untuk layanan yang dipilih belum tersedia.</p>
                    </div>

                    @foreach (var item in Model.PermitPriceList)
                    {
                        <article data-service-key="@item.TypeService"
                                 data-title-key="@item.Title"
                                 x-show="isPermitSelected($el.dataset.serviceKey, $el.dataset.titleKey)"
                                 x-cloak
                                 :class="isPermitSelected($el.dataset.serviceKey, $el.dataset.titleKey) ? 'border-teal-100' : 'border-slate-200 bg-white'"
                                 :style="isPermitSelected($el.dataset.serviceKey, $el.dataset.titleKey) ? 'background-color: #f8fffd' : ''"
                                 class="relative overflow-hidden rounded-2xl border p-4 transition">
                            <div class="absolute inset-y-0 left-0 w-1"
                                 :class="isPermitSelected($el.parentElement.dataset.serviceKey, $el.parentElement.dataset.titleKey) ? 'bg-teal-500' : 'bg-amber-400'"></div>

                            <div class="pl-1">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0">
                                        <p class="text-xs font-extrabold uppercase text-slate-800">@item.Title</p>
                                        @if (!string.IsNullOrWhiteSpace(item.SubTitle ?? item.Description))
                                        {
                                            <p class="mt-1 text-xs text-slate-500">@(item.SubTitle ?? item.Description)</p>
                                        }
                                    </div>
                                </div>

                                <p class="mt-3 text-xs text-slate-500">Biaya</p>
                                <p class="text-lg font-extrabold text-teal-700">@item.PriceText</p>

                                @if (!string.IsNullOrWhiteSpace(item.DocumentUrl))
                                {
                                    <a href="@Url.Page("/CreateServiceOrder/CreateServiceOrder", "Download", new { permitId = item.PermitID })"
                                       download="@item.DownloadFileName"
                                       data-permit-id="@item.PermitID"
                                       data-file-name="@item.DownloadFileName"
                                       @@click.prevent="downloadDocument($event, $el.dataset.permitId, $el.dataset.fileName)"
                                       :class="{ 'pointer-events-none opacity-70': isDownloading('@item.PermitID') }"
                                       :aria-busy="isDownloading('@item.PermitID')"
                                       rel="noopener noreferrer"
                                       aria-label="Unduh persyaratan @item.Title"
                                       class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                                        <i x-show="!isDownloading('@item.PermitID')" class="ri-download-2-line"></i>
                                        <i x-show="isDownloading('@item.PermitID')" x-cloak class="ri-loader-4-line animate-spin"></i>
                                        <span x-text="isDownloading('@item.PermitID') ? 'Mengunduh...' : 'Unduh persyaratan'"></span>
                                    </a>
                                }
                                else
                                {
                                    <span class="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-400">
                                        <i class="ri-file-warning-line"></i>
                                        Dokumen belum tersedia
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </aside>
        }
        </div>
    </div>

    @if (Model.PermitPriceList.Any() && !isKeluhan)
    {
        <div x-show="showPriceList"
             x-cloak
             @@keydown.escape.window="showPriceList = false"
             @@click.self="showPriceList = false"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="service-order-mobile-price fixed inset-0 z-[100] flex items-end justify-center bg-black/40">
            <section x-show="showPriceList"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="translate-y-full"
                     x-transition:enter-end="translate-y-0"
                     x-transition:leave="transition ease-in duration-200"
                     x-transition:leave-start="translate-y-0"
                     x-transition:leave-end="translate-y-full"
                     role="dialog" aria-modal="true" aria-labelledby="priceListTitle"
                     class="service-order-mobile-sheet w-full max-w-2xl overflow-hidden rounded-t-3xl bg-white shadow-2xl">
                <div class="flex justify-center py-2" aria-hidden="true">
                    <span class="h-1 w-10 rounded-full bg-slate-300"></span>
                </div>
                <div class="flex items-start justify-between border-b border-slate-100 px-5 py-4">
                    <div>
                        <h3 id="priceListTitle" class="text-lg font-extrabold text-slate-800">Pricelist layanan terpilih</h3>
                        <p class="mt-1 text-xs text-slate-500" x-text="selectedService"></p>
                    </div>
                    <button type="button" @@click="showPriceList = false" aria-label="Tutup pricelist"
                            class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-500 transition hover:bg-slate-200 hover:text-slate-700">
                        <i class="ri-close-line text-xl"></i>
                    </button>
                </div>

                <div class="service-order-mobile-sheet-list space-y-3 p-4 sm:p-5">
                    @foreach (var item in Model.PermitPriceList)
                    {
                        <article data-service-key="@item.TypeService"
                                 data-title-key="@item.Title"
                                 x-show="isPermitSelected($el.dataset.serviceKey, $el.dataset.titleKey)"
                                 x-cloak
                                 class="service-order-price-card-soft relative overflow-hidden rounded-2xl border border-teal-100 p-4 shadow-sm">
                            <div class="absolute inset-y-0 left-0 w-1 bg-teal-500"></div>
                            <div class="flex flex-col gap-4 pl-1 sm:flex-row sm:items-center sm:justify-between">
                                <div class="min-w-0">
                                    <p class="text-sm font-extrabold uppercase text-slate-800">@item.Title</p>
                                    @if (!string.IsNullOrWhiteSpace(item.SubTitle ?? item.Description))
                                    {
                                        <p class="mt-1 text-xs text-slate-500">@(item.SubTitle ?? item.Description)</p>
                                    }
                                    <p class="mt-2 text-sm text-slate-600">
                                        Biaya: <span class="text-base font-extrabold text-teal-700">@item.PriceText</span>
                                    </p>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.DocumentUrl))
                                {
                                    <a href="@Url.Page("/CreateServiceOrder/CreateServiceOrder", "Download", new { permitId = item.PermitID })"
                                       download="@item.DownloadFileName"
                                       data-permit-id="@item.PermitID"
                                       data-file-name="@item.DownloadFileName"
                                       @@click.prevent="downloadDocument($event, $el.dataset.permitId, $el.dataset.fileName)"
                                       :class="{ 'pointer-events-none opacity-70': isDownloading('@item.PermitID') }"
                                       :aria-busy="isDownloading('@item.PermitID')"
                                       rel="noopener noreferrer"
                                       aria-label="Unduh persyaratan @item.Title"
                                       class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-teal-600 px-4 py-2.5 text-xs font-bold text-white shadow-sm transition hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500/20">
                                        <i x-show="!isDownloading('@item.PermitID')" class="ri-download-2-line"></i>
                                        <i x-show="isDownloading('@item.PermitID')" x-cloak class="ri-loader-4-line animate-spin"></i>
                                        <span x-text="isDownloading('@item.PermitID') ? 'Mengunduh...' : 'Unduh persyaratan'"></span>
                                    </a>
                                }
                                else
                                {
                                    <span class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-slate-100 px-4 py-2.5 text-xs font-bold text-slate-400">
                                        <i class="ri-file-warning-line"></i>
                                        Dokumen belum tersedia
                                    </span>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>
    }
</div>



<script>
    function complaintForm() {
        return {
            previews: [],
            compressedFiles: [],
            loading: false,
            selectedPermit: null,
            selectedService: '',
            downloadingPermitId: null,
            showPriceList: false,
            // Variabel Baru
            compressing: false,
            compressProgress: 0,

            init() {
                this.$nextTick(() => this.syncSelectedPermit());
            },

            syncSelectedPermit() {
                const select = document.getElementById('serviceTypeSelect');
                const option = select?.options[select.selectedIndex];

                this.selectedService = select?.value || '';

                if (!option?.dataset.permitTitle) {
                    this.selectedPermit = null;
                    return;
                }

                this.selectedPermit = {
                    title: option.dataset.permitTitle,
                    subtitle: option.dataset.permitSubtitle,
                    price: option.dataset.permitPrice,
                    documentUrl: option.dataset.permitUrl,
                    permitId: option.dataset.permitId,
                    fileName: option.dataset.permitFilename || 'Dokumen-Persyaratan'
                };
            },

            isDownloading(permitId) {
                return permitId && this.downloadingPermitId === String(permitId);
            },

            async downloadDocument(event, permitId, fileName) {
                const normalizedPermitId = String(permitId || '');
                if (!normalizedPermitId || this.downloadingPermitId) {
                    return;
                }

                this.downloadingPermitId = normalizedPermitId;

                try {
                    const response = await fetch(event.currentTarget.href, {
                        method: 'GET',
                        credentials: 'same-origin'
                    });

                    if (!response.ok) {
                        throw new Error('Dokumen tidak dapat diunduh.');
                    }

                    const fileBlob = await response.blob();
                    const blobUrl = URL.createObjectURL(fileBlob);
                    const downloadLink = document.createElement('a');

                    downloadLink.href = blobUrl;
                    downloadLink.download = fileName || 'Dokumen-Persyaratan';
                    document.body.appendChild(downloadLink);
                    downloadLink.click();
                    downloadLink.remove();

                    setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
                } catch (error) {
                    console.error('Download document error:', error);
                    showError('Gagal', error.message || 'Dokumen tidak dapat diunduh.');
                } finally {
                    this.downloadingPermitId = null;
                }
            },

            normalizeService(value) {
                return (value || '').trim().toLocaleLowerCase('id-ID');
            },

            isPermitSelected(typeService, title) {
                const selected = this.normalizeService(this.selectedService);
                return selected !== '' && (
                    selected === this.normalizeService(typeService)
                    || selected === this.normalizeService(title)
                );
            },

            async previewImages(event) {
                const files = Array.from(event.target.files);
                if (this.previews.length + files.length > 5) {
                    showError('Gagal', 'Maksimal 5 foto saja.');
                    return;
                }

                this.compressing = true;
                this.compressProgress = 0;

                for (const file of files) {
                    // Konfigurasi kompresi dengan onProgress
                    const options = {
                        maxSizeMB: 1,
                        maxWidthOrHeight: 1280,
                        useWebWorker: true,
                        onProgress: (p) => {
                            this.compressProgress = p; // p adalah angka 0-100
                            console.log("Progress:", p); // Cek di console (F12)
                        }
                    };

                    try {
                        const compressedFile = await imageCompression(file, options);
                        this.compressedFiles.push(compressedFile);

                        const reader = new FileReader();
                        reader.onload = (e) => this.previews.push(e.target.result);
                        reader.readAsDataURL(compressedFile);
                    } catch (error) {
                        console.error("Gagal kompres gambar:", error);
                        showError('Gagal', 'Gagal memproses gambar ' + file.name);
                    }
                }
                
                // Reset setelah selesai semua file
                setTimeout(() => {
                    this.compressing = false;
                    this.compressProgress = 0;
                }, 500);

                event.target.value = '';
            },

            removeImage(index) {
                this.previews.splice(index, 1);
                this.compressedFiles.splice(index, 1);
            },

            async submitForm() {
                this.loading = true;

                // Karena kita pakai file hasil kompresi, kita susun FormData secara manual
                const formData = new FormData();

                // Ambil data teks dari form
                formData.append('Input.KavlingId', this.$refs.form.querySelector('[name="Input.KavlingId"]').value);
                formData.append('Input.Title', this.$refs.form.querySelector('[name="Input.Title"]').value);
                formData.append('Input.Description', this.$refs.form.querySelector('[name="Input.Description"]').value);

                // Tambahkan file yang sudah dikompresi
                this.compressedFiles.forEach((file) => {
                    formData.append('Input.Photos', file, file.name);
                });

                try {
                    const response = await fetch('', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    const result = await response.json();

                    if (result.success) {
                        showSuccess('Sukses', result.message);
                        setTimeout(() => {
                                              // 1. Ambil nilai select yang sedang terpilih dan ubah ke huruf kecil
        const selectedService = document.getElementById('serviceTypeSelect').value.toLowerCase();
        
        // 2. Tentukan hash tujuan: jika mengandung kata 'pengaduan', arahkan ke #pengaduan
        const targetHash = selectedService.includes('pengaduan/keluhan') ? '#pengaduan' : '#service';
        
        // 3. Redirect ke halaman akun dengan hash dinamis
        window.location.href = '/AccountUser/AccountUser' + targetHash;
                        }, 2000);
                    } else {
                        showError('Gagal', result.message);
                        this.loading = false;
                    }
                } catch (e) {
                    showError('Error', 'Terjadi kesalahan koneksi.');
                    this.loading = false;
                }
            }
        }
    }
</script>

